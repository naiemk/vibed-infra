{
  "name": "vibed-infra",
  "version": "0.7.0",
  "description": "Product-agnostic VPS packager: wget install, Docker Compose, TLS/nginx, auto-update",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naiemk/vibed-infra.git"
  },
  "bugs": {
    "url": "https://github.com/naiemk/vibed-infra/issues"
  },
  "homepage": "https://github.com/naiemk/vibed-infra#readme",
  "bin": {
    "vibed-infra": "./install.sh"
  },
  "files": [
    "install.sh",
    "package.sh",
    "start.sh",
    "update.sh",
    "install-auto-update.sh",
    "lib",
    "templates",
    "schema",
    "github",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "bash scripts/validate-package.sh",
    "test:oidc": "bash scripts/e2e-oidc-webhook.sh",
    "test:dist": "bash examples/vps-hello/test-dist.sh --profile api && bash examples/vps-hello/test-dist.sh --profile ui && bash examples/vps-hello/test-dist.sh --profile nodes",
    "test:e2e-multi": "bash scripts/e2e-multi-app.sh"
  }
}
