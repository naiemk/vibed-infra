# Host gateway — shared by all vibed-infra apps on this VPS
DOCKER_NETWORK=vps-edge
GATEWAY_NAME=vps-gateway
NGINX_IMAGE=nginx:alpine
TLS_FULLCHAIN=./certs/fullchain.pem
TLS_PRIVKEY=./certs/privkey.pem
CERTBOT_WWW=./certbot-www
HTTP_PORT=80
HTTPS_PORT=443
GATEWAY_MEMORY_LIMIT=64m
GATEWAY_AUTO_UPDATE=0
GATEWAY_AUTO_UPDATE_INTERVAL_MIN=20
GATEWAY_STOP_TIMEOUT=30
DOCKER_AUTO_PRUNE=1
WEBHOOK_PORT=19200
