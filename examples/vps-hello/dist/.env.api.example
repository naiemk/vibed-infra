# Generated by vibed-infra package — edit .env on the VPS, not in git dist.
API_TOKEN=change-me-api-token
DOCKER_NETWORK=vps-edge
DOCKER_NAME=hello-vps-api
BACKEND_IMAGE=hello-vps-api:local
HOST_PORT=8080
# Durable data uses Docker named volume ${DOCKER_NAME}-data by default.
# DATA_VOLUME=custom-data-vol
# DATA_BIND=1
# DATA_DIR=./data
CONFIG_FILE=api-app.yaml
API_MEMORY_LIMIT=256m
# Persist logs: named volume ${DOCKER_NAME}-persist + ship sidecar (default on).
# PERSIST_LOG_VOLUME=custom-persist-vol
# PERSIST_LOGS=0
# PERSIST_LOG_BIND=1
# PERSIST_LOG_DIR=./persist-logs
API_AUTO_UPDATE=0
API_AUTO_UPDATE_INTERVAL_MIN=30
API_STOP_TIMEOUT=60
DOCKER_AUTO_PRUNE=1
DOCKER_PRUNE_UNUSED=0
DOCKER_PRUNE_UNTIL=72h
