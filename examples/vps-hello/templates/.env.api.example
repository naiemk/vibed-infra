# Copied to .env by install-api.sh if missing. Do not commit secrets.

API_TOKEN=change-me-api-token

# Join the gateway Docker network; name must match packageconfig sites[].backend
DOCKER_NETWORK=hello-vps-edge
DOCKER_NAME=hello-api

BACKEND_IMAGE=hello-vps-api:local
HOST_PORT=8080
DATA_DIR=./data
API_MEMORY_LIMIT=256m

# Cron pulls a registry image and recreates this API when the digest changes.
# Leave off for :local images; set 1 after you publish to GHCR.
API_AUTO_UPDATE=0
API_AUTO_UPDATE_INTERVAL_MIN=30
API_STOP_TIMEOUT=60
