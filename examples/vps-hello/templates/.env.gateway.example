# HTTPS nginx + UI. Requires certs on the host (certbot or scripts/gen-dev-certs.sh).

DOCKER_NETWORK=hello-vps-edge
UI_NAME=hello-ui
GATEWAY_NAME=hello-gateway

UI_IMAGE=hello-vps-ui:local
NGINX_IMAGE=nginx:alpine

# Let's Encrypt (replace host with your domain)
TLS_FULLCHAIN=/etc/letsencrypt/live/hello.example.com/fullchain.pem
TLS_PRIVKEY=/etc/letsencrypt/live/hello.example.com/privkey.pem
CERTBOT_WWW=/var/www/certbot

HTTP_PORT=80
HTTPS_PORT=443

UI_AUTO_UPDATE=0
GATEWAY_AUTO_UPDATE=0
GATEWAY_AUTO_UPDATE_INTERVAL_MIN=20
GATEWAY_STOP_TIMEOUT=30
UI_MEMORY_LIMIT=32m
GATEWAY_MEMORY_LIMIT=64m
