# Worker host. Same-VPS: talk to the API container on the edge network.
# Separate VPS: set the public HTTPS URL instead.

API_URL=http://hello-api:8080
API_TOKEN=change-me-api-token

DOCKER_NETWORK=hello-vps-edge
WORKER_IMAGE=hello-vps-worker:local
WORKER_CONTAINER_NAME=hello-worker-heartbeat
WORKER_ROLE=heartbeat
INTERVAL_SEC=60
WORKER_MEMORY_LIMIT=64m

NODES_AUTO_UPDATE=0
NODES_AUTO_UPDATE_INTERVAL_MIN=30
NODES_STOP_TIMEOUT=30
